{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lattes Manager",
  "version": "1.7.1",
  "identifier": "com.ufsc.lattes",
  "build": {
    "frontendDist": "ui"
  },
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "active": true,
    "targets": "all",
    "publisher": "Tiago Olivoto",
    "category": "Productivity",
    "shortDescription": "Gerenciador de comprovantes do Currículo Lattes",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh",
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR"
        ],
        "displayLanguageSelector": false
      }
    },
    "copyright": "© Prof. Dr. Tiago Olivoto — LEMGAD/NEPEM/UFSC",
    "longDescription": "Gestão do currículo Lattes e dos comprovantes: cadastro por DOI/PDF, classificação automática de documentos, relatório de comprovantes em PDF e indicadores.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "section": "utils"
      },
      "rpm": {
        "release": "1"
      }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Lattes Manager",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  }
}